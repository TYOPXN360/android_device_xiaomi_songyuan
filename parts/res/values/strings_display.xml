    <string name="screen_enhance_engine_title">AI image engine</string>
    <string name="screen_enhance_engine_dualDPU_title">Dual-core visuals</string>
    <string name="screen_enhance_engine_dualDPU_summary">Enhance video quality via a dedicated chip</string>
