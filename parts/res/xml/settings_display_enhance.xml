<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/display_enhance_title">

    <com.android.settingslib.widget.MainSwitchPreference
        android:key="display_enhance_ai_enable"
        android:title="@string/display_enhance_switch_title"
        android:summary="@string/display_enhance_switch_summary" />

    <!-- A titled PreferenceCategory draws the child rows as one card, the same
         way accessibility_audio_adjustment.xml and settings_rear_light.xml do.
         SwitchPreferenceCompat is what AOSP uses for these toggles; a
         CheckBoxPreference would render a checkbox instead of a switch. -->
    <PreferenceCategory
        android:key="display_enhance_category"
        android:title="@string/display_enhance_category_title"
        android:persistent="false">

        <SwitchPreferenceCompat
            android:key="display_enhance_memc"
            android:title="@string/display_enhance_memc_title"
            android:summary="@string/display_enhance_memc_summary"
            android:dependency="display_enhance_ai_enable" />

        <SwitchPreferenceCompat
            android:key="display_enhance_s2h"
            android:title="@string/display_enhance_s2h_title"
            android:summary="@string/display_enhance_s2h_summary"
            android:dependency="display_enhance_ai_enable" />

        <SwitchPreferenceCompat
            android:key="display_enhance_sr"
            android:title="@string/display_enhance_sr_title"
            android:summary="@string/display_enhance_sr_summary"
            android:dependency="display_enhance_ai_enable" />

    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="display_enhance_footer"
        android:title="@string/display_enhance_footer"
        android:selectable="false" />

</PreferenceScreen>
