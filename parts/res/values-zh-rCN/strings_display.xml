    <!-- Verbatim stock strings. -->
    <string name="screen_enhance_engine_title">AI大师画质引擎</string>
    <string name="screen_enhance_engine_dualDPU_title">双芯视效</string>
    <string name="screen_enhance_engine_dualDPU_summary">通过独显芯片对视频画质进行增强</string>
    <string name="screen_enhance_engine_dualDPU_note">通过独显芯片对视频进行分辨率提升、动态帧率增强和HDR效果优化，显著增强画面的清晰度、平滑度和深度，从而达到更加生动和立体的视觉体验</string>

    <string name="screen_enhance_engine_memc_title">动态画面补偿</string>
    <string name="screen_enhance_engine_memc_pic_summary">对低帧率视频进行动态插帧处理，使视频画面更加细腻流畅</string>

    <string name="screen_enhance_engine_s2h_title">视频画质增强</string>
    <string name="screen_enhance_engine_s2h_pic_summary">对普通视频画面进行HDR智能画质增强处理，使画面更加艳丽、生动</string>

    <string name="screen_enhance_engine_sr_title">超分辨率增强</string>
    <string name="screen_enhance_engine_sr_pic_summary">对低分辨率图片或视频进行智能分辨率增强处理</string>

    <string name="screen_enhance_engine_ai_title">AI智能场景优化</string>
    <string name="screen_enhance_engine_ai_pic_summary">智能识别画面内容（植物、动物、建筑、风景等），动态调节屏幕显示效果</string>
